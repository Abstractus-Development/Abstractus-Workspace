{
  "name": "abstractus-connector",
  "version": "1.0.0",
  "private": true,
  "description": "Browser connector for Abstractus Desktop, based on the Zotero Connector",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@babel/cli": "^7.8.3",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.8.3",
    "@babel/plugin-transform-react-jsx": "^7.8.3",
    "@babel/preset-react": "^7.8.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "bluebird": "^3.5.3",
    "chai": "^5.2.0",
    "dompurify": "^3.4.15",
    "fake-indexeddb": "^6.2.5",
    "gulp": "^5.0.1",
    "gulp-concat": "^2.6.1",
    "gulp-plumber": "^1.2.1",
    "merge-stream": "^2.0.0",
    "mocha": "^12.0.1",
    "prop-types": "^15.6.2",
    "puppeteer": "^25.3.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-dom-factories": "^1.0.2",
    "rollup": "^4.63.2",
    "semver": "^7.8.5",
    "single-file-core": "1.5.98",
    "sinon": "^22.1.0",
    "through2": "^2.0.5",
    "yargs": "^17.7.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs -d",
    "package": "node scripts/build.mjs --zip",
    "release": "node scripts/release.mjs",
    "watch": "gulp watch",
    "test": "mocha",
    "update-single-file": "scripts/update-single-file",
    "icons": "node scripts/generate-icons.mjs",
    "test:bench": "npm run build && node scripts/test-bench.mjs",
    "sync:check": "python scripts/upstream-sync.py check",
    "sync:prepare": "python scripts/upstream-sync.py prepare",
    "test:sync": "python scripts/test-upstream-sync.py",
    "test:ci": "npm run test:regressions && npm run test:offscreen && npm run test:sync && npm run build && node scripts/test-bench.mjs --ui-only && npm run test:browser && npm run test:connection-ui && npm run test:publisher",
    "test:browser": "node scripts/test-translator-runtime.mjs",
    "test:regressions": "node scripts/test-connector-regressions.mjs",
    "test:connection-ui": "node scripts/test-connection-ui.mjs",
    "test:publisher": "node scripts/test-publisher-runtime.mjs",
    "test:offscreen": "node scripts/test-offscreen-styles.mjs"
  }
}
